# Server configuration
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# API Security (Bearer token)
API_KEY=sk-custom-secret-key

# Model & Thinking Level Defaults
DEFAULT_MODEL=gemini-4-neon
DEFAULT_THINKING_LEVEL=high

# Browser & Gemini settings
HEADLESS=true
AUTH_STATE_PATH=./auth_state.json
GEMINI_URL=https://gemini.google.com/app

# Queue & Timeout limits
MAX_QUEUE_SIZE=50
GENERATION_TIMEOUT_MS=180000
WAIT_STOP_BUTTON_TIMEOUT_MS=15000
